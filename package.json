  "bugs": {
    "url": "https://github.com/dchicchon/roomy/issues"
  },
  "homepage": "https://github.com/dchicchon/roomy#readme",
  "devDependencies": {
    "jsdom": "^26.1.0",
    "vite": "^6.4.5",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "three": "^0.180.0"
  }
}
